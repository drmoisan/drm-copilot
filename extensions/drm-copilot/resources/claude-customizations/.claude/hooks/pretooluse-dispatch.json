{
  "isolation": "in-process",
  "notes": [
    "Generated (issue #1159, D10) from the hooks.PreToolUse groups of .claude/settings.json at the merge base of origin/main and HEAD, in the same group and hook order; regenerate rather than hand-edit.",
    "isolation in-process runs each selected hook in the dispatcher process in its own script scope; per-process (or an absent isolation field) runs each hook as its own pwsh -NoProfile -File child.",
    "A new PreToolUse hook is registered in this registry, not beside the dispatcher entry in .claude/settings.json."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-bash.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-promotion-mcp-only.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-pr-author-skill.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-orchestration-preimplementation-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-epic-merge-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-docs-complete-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-epic-worktree-removal-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-parallel-worktree-removal-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-parallel-abandon-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-worktree-poetry-venv.ps1"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__drm-copilot__run_poshqc_test|mcp__drm-copilot__run_poshqc_suite",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-test-execution-policy.ps1"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/check-python-test-purity.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-python-batch-budget.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/check-powershell-test-purity.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-powershell-batch-budget.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-evidence-locations.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-file-size-limit.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-orchestration-preimplementation-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-feature-folder-order.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-checkpoint-monotonic.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-completion-consistency.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-mermaid-validation.ps1"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|Task|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-discovery-artifact-gate.ps1"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-prd-feature-before-planner.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-discovery-planning-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-orchestration-preimplementation-gate.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-epic-wave-barrier.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-model-routing-receipt.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-epic-invocation-origin.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-parallel-cohort-barrier.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-parallel-drift-gate.ps1"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-docs-role-write-scope.ps1"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/enforce-owner-directive-pass-down.ps1"
          }
        ]
      }
    ]
  }
}
