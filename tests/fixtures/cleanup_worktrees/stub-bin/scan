#!/usr/bin/env bash
# Replaying filesystem-scan stub for the cleanup-worktrees bats suites, wired through
# the CLEANUP_WT_SCAN_BIN seam. It never touches the real filesystem and writes nothing
# to disk: it replays canned stdout and exit codes from the scenario directory named by
# CLEANUP_WT_STUB_SCENARIO, exactly as the sibling git stub in this directory does.
#
# Lookup contract (documented so scenario fixtures under
# tests/fixtures/cleanup_worktrees/scenarios/<name>/ match exactly):
#   For each invocation the stub derives a KEY from the subcommand, then:
#     - if <scenario>/<KEY>.out exists, its bytes are written to stdout;
#     - if <scenario>/<KEY>.rc  exists, the stub exits with that integer;
#     - otherwise stdout is empty and the exit code is 0.
#   The scan surface has a single subcommand and no path- or ref-derived key segment, so
#   no sanitization step is needed and the KEY is fixed.
#
# KEY scheme by subcommand:
#   scan-dirs <root> [<root> ...]            -> scan-dirs
#
# A scenario that defines neither scan-dirs.out nor scan-dirs.rc replays nothing and
# exits 0, which is the correct no-orphan/no-registration-loss shape for every scenario
# authored before this seam existed.
set -uo pipefail

scenario=${CLEANUP_WT_STUB_SCENARIO:-}

respond() {
	# Replay <scenario>/<key>.out to stdout (if present) and exit <scenario>/<key>.rc
	# (default 0). With no scenario configured, emit nothing and exit 0.
	local key="$1"
	local rc=0
	if [[ -n $scenario ]]; then
		if [[ -f "$scenario/$key.out" ]]; then
			cat "$scenario/$key.out"
		fi
		if [[ -f "$scenario/$key.rc" ]]; then
			rc=$(cat "$scenario/$key.rc")
		fi
	fi
	exit "$rc"
}

subcmd=${1:-}
case "$subcmd" in
scan-dirs)
	respond "scan-dirs"
	;;
*)
	exit 0
	;;
esac
