          },
          {
            "approval_mode": "approve",
            "tool": "run_poshqc_format"
          },
          {
            "approval_mode": "approve",
            "tool": "run_poshqc_analyze"
          },
          {
            "approval_mode": "approve",
            "tool": "run_poshqc_test"
