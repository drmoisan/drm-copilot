{
  "name": "drm-copilot",
  "publisher": "drm-copilot",
  "displayName": "drm-copilot",
  "description": "VS Code extension to apply agentic programming customizations to projects.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "drm-copilot"
      }
    ],
    "commands": [
      {
        "command": "drm-copilot.applyCustomizations",
        "title": "DRM Copilot: Apply Agentic Customizations"
      },
      {
        "command": "drm-copilot.loadOpenAIKey",
        "title": "DRM Copilot: Load OpenAI Key"
      },
      {
        "command": "drm-copilot.qcBlackFormat",
        "title": "DRM Copilot: QC 1 - Black Format"
      },
      {
        "command": "drm-copilot.qcRuffLint",
        "title": "DRM Copilot: QC 2 - Ruff Lint"
      },
      {
        "command": "drm-copilot.qcRuffFix",
        "title": "DRM Copilot: QC 2 - Ruff Fix"
      },
      {
        "command": "drm-copilot.qcPyrightTypeCheck",
        "title": "DRM Copilot: QC 3 - Pyright Type Check"
      },
      {
        "command": "drm-copilot.qcPytestRunTests",
        "title": "DRM Copilot: QC 4 - Pytest Run Tests"
      },
      {
        "command": "drm-copilot.qcPytestRunTestsCoverage",
        "title": "DRM Copilot: QC 4 - Pytest Run Tests with Coverage"
      },
      {
        "command": "drm-copilot.poshQCFormat",
        "title": "DRM Copilot: PoshQC 1 - Format PowerShell"
      },
      {
        "command": "drm-copilot.poshQCAnalyze",
        "title": "DRM Copilot: PoshQC 2 - Analyze PowerShell"
      },
      {
        "command": "drm-copilot.poshQCAutofix",
        "title": "DRM Copilot: PoshQC 2b - Autofix (PSSA -Fix)"
      },
      {
        "command": "drm-copilot.poshQCTest",
        "title": "DRM Copilot: PoshQC 4 - Test (Pester)"
      },
      {
        "command": "drm-copilot.qcRunAllChecks",
        "title": "DRM Copilot: QC 5 - Run All Checks"
      },
      {
        "command": "drm-copilot.qcFixAll",
        "title": "DRM Copilot: QC 0 - Fix All"
      },
      {
        "command": "drm-copilot.jsonFormat",
        "title": "DRM Copilot: JSON Format"
      },
      {
        "command": "drm-copilot.jsonValidate",
        "title": "DRM Copilot: JSON Validate"
      },
      {
        "command": "drm-copilot.formatChatFile",
        "title": "DRM Copilot: Format Current Chat File"
