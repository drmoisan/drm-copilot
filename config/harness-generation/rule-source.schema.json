{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/harness-generation/rule-source.schema.json",
  "title": "Harness generation path-scoped rule source",
  "description": "One source per Claude rule under scripts/harness-generation/sources/rules/ (issue #1028); its section body is the sibling <name>.md.",
  "type": "object",
  "required": ["$schema", "targets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "claudeUnconditional": { "type": "boolean" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frontmatter", "kind", "path", "sections"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["claude", "copilot", "codex"] },
          "path": { "type": "string", "minLength": 1 },
          "frontmatter": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "value": { "type": "string" }
              }
            }
          },
          "sections": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
          "substitutions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["find", "replace"],
              "additionalProperties": false,
              "properties": {
                "find": { "type": "string", "minLength": 1 },
                "replace": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
