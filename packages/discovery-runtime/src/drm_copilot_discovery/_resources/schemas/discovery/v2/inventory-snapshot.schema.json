{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drm-copilot:discovery:2.0.0:inventory-snapshot",
  "title": "Discovery v2 inventory snapshot",
  "description": "Pinned analyzer input and detections. File sorting, digest recomputation, exact accounting and relationship resolution require semantic validation; detection never implies inspection.",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "artifact_kind", "id", "repository", "revision", "tool", "analyzers", "scan_configuration_sha256", "files", "components", "findings", "relationships", "diagnostics", "exclusions", "capture", "extensions"],
  "properties": {
    "$schema": {"const": "urn:drm-copilot:discovery:2.0.0:inventory-snapshot"},
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "inventory-snapshot"},
    "id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
    "repository": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
    "revision": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/revision"},
    "tool": {"$ref": "#/$defs/tool"},
    "analyzers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
    "scan_configuration_sha256": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"},
    "files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/component"}},
    "findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}},
    "relationships": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relationship"}},
    "diagnostics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/diagnostic"}},
    "exclusions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/exclusions"},
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["timestamp", "author_or_agent"],
      "properties": {
        "timestamp": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/timestamp"},
        "author_or_agent": {"$ref": "urn:drm-copilot:discovery:2.0.0:evidence-reference#/properties/author_or_agent"}
      }
    },
    "extensions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/extensions"}
  },
  "$defs": {
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"}, "version": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision", "path", "sha256"],
      "properties": {
        "repository": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "revision": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/revision"},
        "path": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/relative-path"},
        "sha256": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"},
        "symbol": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"},
        "line_range": {"$ref": "urn:drm-copilot:discovery:2.0.0:evidence-reference#/properties/line_range"}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "status", "sha256", "size", "rationale", "diagnostic_ids"],
      "properties": {
        "path": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/relative-path"},
        "status": {"enum": ["inspected", "excluded", "unreadable"]},
        "sha256": {"anyOf": [{"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"}, {"type": "null"}]},
        "size": {"type": ["integer", "null"], "minimum": 0},
        "rationale": {"anyOf": [{"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"}, {"type": "null"}]},
        "diagnostic_ids": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifiers"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "inspected"}}, "required": ["status"]},
          "then": {"properties": {"sha256": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"}, "size": {"type": "integer"}, "rationale": {"type": "null"}}},
          "else": {"properties": {"sha256": {"type": "null"}, "size": {"type": "null"}, "rationale": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"}}}
        },
        {
          "if": {"properties": {"status": {"const": "unreadable"}}, "required": ["status"]},
          "then": {"properties": {"diagnostic_ids": {"minItems": 1}}}
        }
      ]
    },
    "properties": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "value"],
        "properties": {
          "name": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
          "value": {"type": ["string", "number", "boolean", "null"]}
        }
      },
      "description": "Scalar analyzer declaration data; structured domain metadata belongs in extensions."
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "component_type", "source", "analyzer", "classification", "confidence", "properties", "extensions"],
      "properties": {
        "component_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "component_type": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "source": {"$ref": "#/$defs/source"},
        "analyzer": {"$ref": "#/$defs/tool"},
        "classification": {"enum": ["detected", "inferred"]},
        "confidence": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/confidence"},
        "properties": {"$ref": "#/$defs/properties"},
        "extensions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/extensions"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "component_id", "kind", "source", "analyzer", "classification", "confidence", "properties", "extensions"],
      "properties": {
        "finding_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "component_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "kind": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "source": {"$ref": "#/$defs/source"},
        "analyzer": {"$ref": "#/$defs/tool"},
        "classification": {"enum": ["detected", "inferred"]},
        "confidence": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/confidence"},
        "properties": {"$ref": "#/$defs/properties"},
        "extensions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/extensions"}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_id", "from_component_id", "to_component_id", "target_description", "kind", "source", "analyzer", "classification", "confidence", "extensions"],
      "properties": {
        "relationship_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "from_component_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "to_component_id": {"anyOf": [{"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"}, {"type": "null"}]},
        "target_description": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"},
        "kind": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "source": {"$ref": "#/$defs/source"},
        "analyzer": {"$ref": "#/$defs/tool"},
        "classification": {"enum": ["detected", "inferred"]},
        "confidence": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/confidence"},
        "extensions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/extensions"}
      },
      "description": "A declared relationship can be detected while its target binding remains unresolved; a null target ID does not invent symbol resolution."
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["id", "code", "severity", "path", "message", "analyzer_id", "blocking", "extensions"],
      "properties": {
        "id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "code": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "severity": {"enum": ["information", "warning", "error"]},
        "path": {"anyOf": [{"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/relative-path"}, {"type": "null"}]},
        "message": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"},
        "analyzer_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
        "blocking": {"type": "boolean"},
        "extensions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/extensions"}
      }
    }
  }
}
