{
  "$schema": "https://containers.dev/schemas/devcontainer.schema.json",
  "build": {
    "context": "../..",
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "BG_WORKTREE_PATH": "/workspaces/drm-copilot-bg",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false",
    "TZ": "America/New_York"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.jupyter-renderers",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "AdamViola.parquet-explorer",
        "zeshuaro.vscode-python-poetry",
        "ms-vscode.live-server",
        "ms-vscode.powershell",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "graphite.gti-vscode",
        "github.vscode-pull-request-github",
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint",
        "humao.rest-client",
        "ryanluker.vscode-coverage-gutters",
        "tenninebt.vscode-koverage",
        "pspester.pester-test",
        "ms-azuretools.vscode-containers",
        "bierner.markdown-preview-github-styles",
        "bierner.markdown-mermaid",
        "mechatroner.rainbow-csv",
        "openai.chatgpt",
        "github.vscode-github-actions",
        "bierner.markdown-checkbox",
        "mads-hartmann.bash-ide-vscode",
        "ms-toolsai.datawrangler",
        "ms-vscode.extension-test-runner",
        "Orta.vscode-jest",
        "ZainChen.json",
        "jq-syntax-highlighting.jq-syntax-highlighting",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          },
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.args": [
          "--config",
          "${workspaceFolder}/pyproject.toml"
        ],
        "powershell.codeFormatting.preset": "OTBS",
        "powershell.integratedConsole.showOnStartup": false,
        "powershell.integratedConsole.startInBackground": true,
        "powershell.scriptAnalysis.enable": true,
        "powershell.scriptAnalysis.settingsPath": "${workspaceFolder}/scripts/powershell/PoshQC/settings/pssa.settings.psd1",
        "python.analysis.typeCheckingMode": "strict",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.formatting.provider": "none",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "icon": "terminal-bash",
            "path": "/bin/bash"
          },
          "pwsh": {
            "args": ["-NoLogo"],
            "icon": "terminal-powershell",
            "path": "/usr/bin/pwsh"
          }
        },
        "terminal.integrated.shellIntegration.enabled": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-local-venv,target=/workspaces/drm-copilot/.venv,type=volume,volume-nocopy",
    "source=${localWorkspaceFolderBasename}-local-node-modules,target=/workspaces/drm-copilot/node_modules,type=volume,volume-nocopy",
    "source=${localWorkspaceFolderBasename}-local-extension-node-modules,target=/workspaces/drm-copilot/extensions/drm-copilot/node_modules,type=volume,volume-nocopy",
    "source=${localWorkspaceFolderBasename}-local-mcp-node-modules,target=/workspaces/drm-copilot/packages/mcp-server/node_modules,type=volume,volume-nocopy",
    "source=${localWorkspaceFolderBasename}-workspace-bg,target=/workspaces/drm-copilot-bg,type=volume"
  ],
  "name": "DRM Copilot Dev Container",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/drm-copilot",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/drm-copilot,type=bind,consistency=cached"
}
