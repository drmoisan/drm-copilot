#!/usr/bin/env bash
# Recording git stub for the cleanup-worktrees bats suites, wired through the
# CLEANUP_WT_GIT_BIN seam. It never touches a real repository and writes nothing to
# disk: it replays canned stdout and exit codes from the scenario directory named by
# CLEANUP_WT_STUB_SCENARIO, and echoes each invocation as a `stub-git: <argv>` line
# to STDERR so tests can assert which commands ran. The invocation log is on stderr
# (not stdout) so a caller capturing git stdout via command substitution receives
# only the canned data; under bats `run` the stderr log still merges into $output.
#
# Lookup contract (documented so scenario fixtures under
# tests/fixtures/cleanup_worktrees/scenarios/<name>/ match exactly):
#   For each invocation the stub derives a KEY from the (global-option-stripped)
#   argv, then:
#     - if <scenario>/<KEY>.out exists, its bytes are written to stdout;
#     - if <scenario>/<KEY>.rc  exists, the stub exits with that integer;
#     - otherwise stdout is empty and the exit code is 0.
#   Path/ref characters outside [A-Za-z0-9._-] are replaced with `_` when forming a
#   KEY (so refs/heads/x -> refs_heads_x, branch:path -> branch_path).
#
# KEY scheme by subcommand:
#   for-each-ref ... <pattern>               -> for-each-ref.<pattern>, falling back to
#                                               for-each-ref ONLY when <pattern> is the
#                                               literal refs/heads/. Any other pattern
#                                               with no specific fixture resolves to
#                                               empty stdout and exit 0, so a
#                                               refs/remotes/-scoped read can never pick
#                                               up refs/heads/-shaped branch data.
#   worktree list --porcelain                -> worktree-list
#   worktree add ...                         -> worktree-add
#   worktree remove <path>                   -> worktree-remove
#   merge-base --is-ancestor <tip> <up>      -> merge-base.<tip>.<up>, falling back to
#                                               merge-base.<tip> when the scenario
#                                               supplies no target-aware fixture. Every
#                                               scenario authored before the target-aware
#                                               key existed supplies only the bare form,
#                                               so the fallback preserves their behavior.
#   rev-list ... main..<branch>              -> rev-list.<branch>
#   rev-list ... <rev>   (no .. range)       -> rev-list.<rev>
#   diff --quiet main...<branch>             -> diff-quiet.<branch>
#   diff --quiet main <branch> -- <path>     -> diff-quiet.<branch>.<path>
#   diff (no --quiet) ... -- <path>          -> diff.<-C path>.<path>
#   diff (no --quiet) --cached ... -- <path> -> diff-cached.<-C path>.<path>
#   cherry main <branch>                     -> cherry.<branch>
#   diff-tree ... <sha>                      -> diff-tree.<sha>
#   ls-tree <ref> -- <path>                  -> ls-tree.<ref>_<path>
#   rev-parse --abbrev-ref HEAD              -> rev-parse.abbrev-ref-HEAD
#   rev-parse --show-toplevel                -> rev-parse.show-toplevel
#   rev-parse --verify --quiet <ref>         -> rev-parse.verify.<ref>
#   rev-parse <rev>                          -> rev-parse.<rev>
#   status --porcelain (with -C <path>)      -> status.<path>  (else status)
#   cherry-pick -x <sha>                     -> cherry-pick.<sha>
#   cherry-pick --abort                      -> cherry-pick-abort
#   cherry-pick --skip                       -> cherry-pick-skip
#   branch -D <name>                         -> branch-D.<name>
#   fetch ...                                -> fetch
#   remote                                   -> remote
#   hash-object ... -- <path>                -> hash-object.<path>
#   log ... --find-object=<oid> ...          -> log.find-object.<oid>
#   diff-index --cached --quiet <commit> --  -> diff-index.<commit>
#   reset --hard                             -> reset-hard
#   clean -fd                                -> clean
#
# Global options stripped before the subcommand: `-C <path>` (the last value is
# retained for per-worktree keys), `-c <name>=<value>`, and `--no-optional-locks`.
#
# No arm is defined for any subcommand that writes to the index or the object database.
# The dirt classifier must reach its staged-tree answer by reading only, so defining
# such an arm would make the report-mode non-mutation assertion unable to fail. The
# assertion in tests/shell/test_cleanup_worktrees_dirt_clear.bats searches this file's
# argv log for those subcommand names; adding one here would defeat it.
set -uo pipefail

# Echo the full invocation to stderr for argv assertions.
printf 'stub-git: %s\n' "$*" >&2

# Echo GIT_INDEX_FILE to stderr when, and only when, it is set in the environment.
# Redirecting the index to a scratch file is a mutation of state the report path must
# never touch, and it is invisible in the argv log because it travels in the
# environment rather than the argument vector. This sentinel is what the report-mode
# non-mutation assertion reads. The guard is load-bearing in both directions: an
# unguarded line would emit the token on every invocation and make the assertion
# unable to fail, and a missing line would make it unable to fail the other way.
if [[ -n ${GIT_INDEX_FILE+x} ]]; then
	printf 'stub-git-env: GIT_INDEX_FILE=%s\n' "$GIT_INDEX_FILE" >&2
fi

scenario=${CLEANUP_WT_STUB_SCENARIO:-}

sanitize() {
	# Replace every character outside [A-Za-z0-9._-] with an underscore.
	local s=${1:-}
	printf '%s' "${s//[^A-Za-z0-9._-]/_}"
}

respond() {
	# Replay <scenario>/<key>.out to stdout (if present) and exit <scenario>/<key>.rc
	# (default 0). With no scenario configured, emit nothing and exit 0.
	local key="$1"
	local rc=0
	if [[ -n $scenario ]]; then
		if [[ -f "$scenario/$key.out" ]]; then
			cat "$scenario/$key.out"
		fi
		if [[ -f "$scenario/$key.rc" ]]; then
			rc=$(cat "$scenario/$key.rc")
		fi
	fi
	exit "$rc"
}

# Strip leading global options that precede the subcommand. Only the forms this tool
# emits are handled: `-C <path>` and `-c <name>=<value>`. The last `-C <path>` value
# is retained so status/other per-worktree keys can incorporate it.
dash_c_path=""
args=("$@")
i=0
while ((i < ${#args[@]})); do
	case "${args[$i]}" in
	-C)
		dash_c_path="${args[$((i + 1))]:-}"
		i=$((i + 2))
		;;
	-c)
		i=$((i + 2))
		;;
	--no-optional-locks)
		# A leading global option that takes no operand, so the index advances by one.
		# Without this arm the option is read as the subcommand and every read the dirt
		# classifier issues falls through to the default `*) exit 0` case, replaying no
		# canned response at all.
		i=$((i + 1))
		;;
	*)
		break
		;;
	esac
done
# Rebuild the positional list without the consumed global options.
rest=("${args[@]:$i}")
set -- "${rest[@]:-}"

subcmd=${1:-}
case "$subcmd" in
for-each-ref)
	# Key on the refspec pattern (the last argument) so a refs/remotes/-scoped read
	# cannot replay a refs/heads/-shaped fixture. The bare `for-each-ref` key remains
	# the fallback for the sole historical call shape (pattern refs/heads/) only.
	pattern=""
	for a in "$@"; do pattern=$a; done
	pattern_key="for-each-ref.$(sanitize "$pattern")"
	if [[ -n $scenario ]] &&
		{ [[ -f "$scenario/$pattern_key.out" ]] || [[ -f "$scenario/$pattern_key.rc" ]]; }; then
		respond "$pattern_key"
	fi
	if [[ $pattern == "refs/heads/" ]]; then
		respond "for-each-ref"
	fi
	respond "$pattern_key"
	;;
worktree)
	case "${2:-}" in
	list) respond "worktree-list" ;;
	add) respond "worktree-add" ;;
	remove) respond "worktree-remove" ;;
	*) exit 0 ;;
	esac
	;;
merge-base)
	# merge-base --is-ancestor <tip> <upstream>: prefer the target-aware key
	# merge-base.<tip>.<up> when the scenario supplies one, so a scenario can give two
	# different answers for the same tip probed against two different upstreams. Fall
	# back to the historical bare merge-base.<tip> key otherwise.
	if [[ ${2:-} == "--is-ancestor" ]]; then
		tip_key="$(sanitize "${3:-}")"
		up_key="$(sanitize "${4:-}")"
		pair_key="merge-base.${tip_key}.${up_key}"
		if [[ -n $scenario ]] &&
			{ [[ -f "$scenario/$pair_key.out" ]] || [[ -f "$scenario/$pair_key.rc" ]]; }; then
			respond "$pair_key"
		fi
		respond "merge-base.${tip_key}"
	fi
	exit 0
	;;
rev-list)
	# Prefer the range argument (contains ..) and key on the branch after the dots. A
	# range-free invocation such as `rev-list --max-count=201 HEAD` keys on its trailing
	# revision operand instead: keying it on the absent range would derive the single
	# unusable key `rev-list.` for every range-free call, so no scenario could supply a
	# per-revision response.
	range=""
	revarg=""
	for a in "$@"; do
		[[ $a == *".."* ]] && range=$a
		[[ $a != -* && $a != "rev-list" ]] && revarg=$a
	done
	if [[ -n $range ]]; then
		branch=${range##*..}
	else
		branch=$revarg
	fi
	respond "rev-list.$(sanitize "$branch")"
	;;
diff)
	# diff --quiet main...<branch> [-- <path>] keeps the historical diff-quiet. keys,
	# whose answer is carried entirely by an exit code.
	#
	# A diff WITHOUT --quiet is a content read whose STDOUT must be replayable, so it
	# keys separately and incorporates the retained -C worktree path:
	#   diff --no-color -U0 -- <path>          -> diff.<-C path>.<path>
	#   diff --no-color -U0 --cached -- <path> -> diff-cached.<-C path>.<path>
	# The two forms are distinguished so one scenario can supply a worktree diff and a
	# cached diff for the same file without one overwriting the other.
	spec=""
	path=""
	quiet=0
	cached=0
	seen_dashdash=0
	for a in "$@"; do
		if ((seen_dashdash == 1)); then
			path=$a
			break
		fi
		[[ $a == "--quiet" ]] && quiet=1
		[[ $a == "--cached" ]] && cached=1
		[[ $a == "--" ]] && seen_dashdash=1
		[[ $a == *"..."* ]] && spec=${a##*...}
		[[ $a == *".."* && $a != *"..."* ]] && spec=${a##*..}
	done
	if ((quiet == 0)); then
		if ((cached == 1)); then
			respond "diff-cached.$(sanitize "$dash_c_path").$(sanitize "$path")"
		fi
		respond "diff.$(sanitize "$dash_c_path").$(sanitize "$path")"
	fi
	if [[ -n $path ]]; then
		respond "diff-quiet.$(sanitize "$spec").$(sanitize "$path")"
	fi
	respond "diff-quiet.$(sanitize "$spec")"
	;;
cherry)
	# cherry main <branch>
	respond "cherry.$(sanitize "${3:-}")"
	;;
diff-tree)
	# Last argument is the commit SHA.
	sha=""
	for a in "$@"; do sha=$a; done
	respond "diff-tree.$(sanitize "$sha")"
	;;
ls-tree)
	# ls-tree <ref> -- <path>: KEY is ls-tree.<sanitized-ref>_<sanitized-path>.
	ref=${2:-}
	lspath=""
	seen_dashdash=0
	for a in "$@"; do
		if ((seen_dashdash == 1)); then
			lspath=$a
			break
		fi
		[[ $a == "--" ]] && seen_dashdash=1
	done
	respond "ls-tree.$(sanitize "$ref")_$(sanitize "$lspath")"
	;;
rev-parse)
	if [[ ${2:-} == "--abbrev-ref" ]]; then
		respond "rev-parse.abbrev-ref-HEAD"
	elif [[ ${2:-} == "--show-toplevel" ]]; then
		respond "rev-parse.show-toplevel"
	elif [[ ${2:-} == "--verify" && ${3:-} == "--quiet" ]]; then
		respond "rev-parse.verify.$(sanitize "${4:-}")"
	else
		respond "rev-parse.$(sanitize "${2:-}")"
	fi
	;;
status)
	if [[ -n $dash_c_path ]]; then
		respond "status.$(sanitize "$dash_c_path")"
	fi
	respond "status"
	;;
cherry-pick)
	case "${2:-}" in
	--abort) respond "cherry-pick-abort" ;;
	--skip) respond "cherry-pick-skip" ;;
	*)
		# cherry-pick [-x] <sha>: the SHA is the last argument.
		sha=""
		for a in "$@"; do sha=$a; done
		respond "cherry-pick.$(sanitize "$sha")"
		;;
	esac
	;;
branch)
	if [[ ${2:-} == "-D" ]]; then
		respond "branch-D.$(sanitize "${3:-}")"
	fi
	exit 0
	;;
fetch)
	respond "fetch"
	;;
remote)
	respond "remote"
	;;
hash-object)
	# hash-object [-t <type>] -- <path>: KEY is hash-object.<sanitized path after -->.
	# This is a READ of a working-tree file's blob id. The stub defines no -w behavior
	# because the dirt classifier never writes an object.
	hopath=""
	seen_dashdash=0
	for a in "$@"; do
		if ((seen_dashdash == 1)); then
			hopath=$a
			break
		fi
		[[ $a == "--" ]] && seen_dashdash=1
	done
	respond "hash-object.$(sanitize "$hopath")"
	;;
log)
	# log <range> --find-object=<oid> ...: KEY is log.find-object.<sanitized oid>. The
	# range operand is deliberately excluded from the key so the bounded-range form and
	# the plain-main fallback form replay the same canned answer for the same blob; the
	# range each form used is still observable in the argv log.
	findobj=""
	for a in "$@"; do
		[[ $a == --find-object=* ]] && findobj=${a#--find-object=}
	done
	respond "log.find-object.$(sanitize "$findobj")"
	;;
diff-index)
	# diff-index --cached --quiet <commit> --: KEY is diff-index.<sanitized commit>.
	# The commit is the first non-option operand after the subcommand, so a scenario
	# supplies one .rc file per candidate commit and can answer differently for each.
	dicommit=""
	diseen=0
	for a in "$@"; do
		if ((diseen == 0)); then
			diseen=1
			continue
		fi
		[[ $a == -* ]] && continue
		dicommit=$a
		break
	done
	respond "diff-index.$(sanitize "$dicommit")"
	;;
reset)
	# reset --hard: KEY is the fixed reset-hard. The full argv, including the absence of
	# any additional flag, remains observable in the argv log.
	respond "reset-hard"
	;;
clean)
	# clean -fd: KEY is the fixed clean. The full argv, including the absence of -x, -X,
	# and -ff, remains observable in the argv log.
	respond "clean"
	;;
*)
	exit 0
	;;
esac
