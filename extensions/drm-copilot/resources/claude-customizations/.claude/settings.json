{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(poetry run *)",
      "Bash(pwsh *)",
      "Bash(bash .claude/lib/bash/abandon-parallel-item.sh*)",
      "Bash(bash .claude/lib/bash/compute-cohorts.sh*)",
      "Bash(bash .claude/lib/bash/compute-concurrency-batches.sh*)",
      "Bash(bash .claude/lib/bash/mutate-parallel-run.sh*)",
      "Bash(bash .claude/lib/bash/remove-parallel-item.sh*)",
      "Bash(bash .claude/lib/bash/validate-parallel-manifest.sh*)",
      "Bash(pwsh -NoProfile -NonInteractive -File .claude/lib/parallel-admission/Invoke-ParallelAdmission.ps1*)",
      "Read",
      "Edit(docs/**)",
      "Edit(artifacts/**)",
      "mcp__drm-copilot__run_poshqc_format",
      "mcp__drm-copilot__run_poshqc_analyze",
      "mcp__drm-copilot__run_poshqc_test",
      "mcp__drm-copilot__run_poshqc_analyze_autofix",
      "mcp__drm-copilot__resolve_execute_hard_lock_prompt",
      "mcp__drm-copilot__collect_pr_context",
      "mcp__drm-copilot__new_potential_entry",
      "mcp__drm-copilot__new_potential_bug_entry",
      "mcp__drm-copilot__potential_to_issue",
      "mcp__drm-copilot__new_active_feature_folder",
      "mcp__drm-copilot__validate_orchestration_artifacts",
      "mcp__drm-copilot__resolve_atomic_plan_prompt",
      "mcp__drm-copilot__render_subagent_tree",
      "Agent(atomic-planner)",
      "Agent(atomic-executor)",
      "Agent(feature-review)",
      "Agent(task-researcher)",
      "Agent(prd-feature)",
      "Agent(staged-review)",
      "Agent(epic-review)",
      "Agent(status-updater)",
      "Agent(pr-author)",
      "Agent(commit-message)",
      "Agent(human-exception-runbook)",
      "Agent(python-typed-engineer)",
      "Agent(powershell-typed-engineer)",
      "Agent(csharp-typed-engineer)",
      "Agent(typescript-engineer)",
      "Agent(epic-orchestrator)",
      "Agent(epic-planner)",
      "Skill(orchestrate *)",
      "Skill(epic-plan *)",
      "Skill(epic-orchestrate *)",
      "Skill(epic-run *)",
      "Skill(commit-message *)",
      "Skill(pr-author *)",
      "Skill(research-issue *)",
      "Skill(review-feature *)",
      "Skill(review-staged *)",
      "Skill(review-epic *)",
      "Skill(update-status *)",
      "Skill(fill-feature-docs *)",
      "Skill(python-change-budget-router *)",
      "Skill(python-qa-gate *)",
      "Skill(invoke-python-engineer *)",
      "Skill(powershell-change-budget-router *)",
      "Skill(powershell-qa-gate *)",
      "Skill(invoke-powershell-engineer *)",
      "Skill(translate-copilot-to-claude *)",
      "Skill(execute-hard-lock *)",
      "Skill(identify-session-id *)",
      "Skill(show-my-agent-tree *)",
      "Skill(mermaid-diagram *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)"
    ],
    "additionalDirectories": [
      "c:\\Users\\DanMoisan\\repos\\drm-copilot\\.claude\\skills\\execute-hard-lock"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/persist-session-id.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|Task|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/invoke-pretooluse-dispatch.ps1"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "legacy-parity-analyst|runtime-characterization-analyst|requirements-reconciler|migration-coverage-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/record-discovery-agent-start.ps1"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "atomic-planner|atomic-executor|feature-review|task-researcher|prd-feature|staged-review|epic-review|status-updater|python-typed-engineer|powershell-typed-engineer|csharp-typed-engineer|typescript-engineer|orchestrator|epic-orchestrator|epic-planner",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-discovery-artifact-gate.ps1"
          }
        ]
      },
      {
        "matcher": "legacy-parity-analyst|runtime-characterization-analyst|requirements-reconciler|migration-coverage-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-discovery-artifact-gate.ps1"
          }
        ]
      },
      {
        "matcher": "feature-review",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-feature-review-coverage.ps1"
          }
        ]
      },
      {
        "matcher": "atomic-planner",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-planner-output.ps1"
          }
        ]
      },
      {
        "matcher": "prd-feature",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-prd-feature-output.ps1"
          }
        ]
      },
      {
        "matcher": "pr-author",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-pr-author-output.ps1"
          }
        ]
      },
      {
        "matcher": "orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-orchestrator-output.ps1"
          }
        ]
      },
      {
        "matcher": "epic-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-orchestrator-output.ps1 -CheckpointPath artifacts/orchestration/epic-orchestrator-state.json -ArtifactType epic-orchestrator-state"
          }
        ]
      },
      {
        "matcher": "parallel-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-orchestrator-output.ps1 -CheckpointPath artifacts/orchestration/parallel-orchestrator-state.json -ArtifactType parallel-orchestrator-state"
          }
        ]
      },
      {
        "matcher": "docs-architect|docs-author|docs-reconciler|docs-coverage-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/validate-docs-role-output.ps1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "defaultPermissionMode": "bypassPermissions"
}
