{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drm-copilot:discovery:2.0.0:root-grant",
  "title": "Discovery v2 one-use root grant",
  "description": "Only a protected native PreToolUse event that observed a root payload (no agent identity) can issue this record. The server consumes it by tool, operation and input digest and takes host, session and parent from it. Correlation IDs and supplied hashes are never authorization on their own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_kind",
    "id",
    "grant_ref",
    "host",
    "session_id",
    "parent_agent_id",
    "tool",
    "operation",
    "input_sha256",
    "tool_use_id",
    "handler_sha256",
    "issued_at",
    "expires_at",
    "state"
  ],
  "properties": {
    "$schema": {"const":"urn:drm-copilot:discovery:2.0.0:root-grant"},
    "schema_version": {"const":"2.0.0"},
    "artifact_kind": {"const":"root-grant"},
    "id": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
    "grant_ref": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/opaque-reference"},
    "host": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/host"},
    "session_id": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},
    "parent_agent_id": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},
    "tool": {
      "enum": [
        "prepare_discovery_agent",
        "run_discovery_doctor",
        "read_discovery_source",
        "run_discovery_repo_inventory",
        "run_discovery_dotnet_analyzer",
        "run_discovery_vsto_analyzer",
        "create_discovery_artifact",
        "update_discovery_artifact",
        "link_discovery_evidence",
        "run_discovery_scenario_generation",
        "run_discovery_report",
        "validate_discovery_artifacts",
        "finalize_discovery_agent"
      ]
    },
    "operation": {
      "enum": [
        "prepare-agent",
        "doctor",
        "profile",
        "inventory",
        "new-contract",
        "new-scenario",
        "update-artifact",
        "link-evidence",
        "validate-profile",
        "validate-feature-contract",
        "validate-coverage-ledger",
        "validate-runtime-scenario",
        "validate-parity-matrix",
        "validate-unspecified-behavior",
        "validate-product-decision",
        "validate-evidence-reference",
        "validate-decisions",
        "validate-all",
        "coverage-report",
        "parity-report",
        "completion-report",
        "generate-acceptance",
        "read-source",
        "finalize-agent"
      ]
    },
    "input_sha256": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"},
    "tool_use_id": {"anyOf":[{"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},{"type":"null"}]},
    "handler_sha256": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"},
    "issued_at": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/timestamp"},
    "expires_at": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/timestamp"},
    "state": {"enum":["issued","consumed","revoked"]}
  }
}
