{	
    "coverage-gutters.coverageBaseDir": "**",
    "coverage-gutters.coverageFileNames": [
        "lcov.info",
        "cov.xml",
        "coverage.xml",
        "cobertura.xml",
        "jacoco.xml",
        "coverage.cobertura.xml",
        "powershell-coverage.xml"
    ],
    "coverage-gutters.showGutterCoverage": true,
    "coverage-gutters.showLineCoverage": true,
    "koverage.coverageFileNames": [
        "lcov.info",
        "cov.xml",
        "clover.xml",
        "coverage.xml",
        "jacoco.xml",
        "powershell-coverage.koverage.xml"
    ],
    "koverage.coverageFilePaths": [
        "coverage",
        "artifacts/pester",
        "artifacts/pester/kcov/kcov-merged",
        "artifacts/python"
    ],
    "jest.jestCommandLine": "npm run test:unit --",
    "jest.rootPath": ".",
    "jest.runMode": "on-demand",
    "jest.useJest30": true,
    "powershell.cwd": "${workspaceFolder}",
    "powershell.powerShellAdditionalExePaths": {
        "PowerShell 7 (Workspace)": "C:/Program Files/PowerShell/7/pwsh.exe"
    },
    "powershell.powerShellDefaultVersion": "PowerShell 7 (Workspace)",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],
    "python.testing.autoTestDiscoverOnSaveEnabled": false
}
