+)
+_TS_SUITE = (
+    _REPO_ROOT
+    / "extensions"
+    / "drm-copilot"
+    / "test"
+    / "lib"
+    / "validate"
+    / "plan-gate-guideline-cutoff.test.ts"
+)
+
+# One instant written in both zones: 10:00 in New York is 15:00 UTC.
+_CUTOFF = {"America/New_York": "2026-11-07T10-00", "UTC": "2026-11-07T15-00"}
