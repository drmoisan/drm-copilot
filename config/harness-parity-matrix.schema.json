{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drm-copilot.dev/schemas/harness-parity-matrix/1.0.0/schema.json",
  "title": "Harness parity matrix",
  "description": "One entry per native feature of Claude Code, Codex and GitHub Copilot, each with one disposition (issue #1025).",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "features"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://drm-copilot.dev/schemas/harness-parity-matrix/1.0.0/schema.json"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "kind", "name", "source_path", "disposition", "parity_group", "consumers", "owner_child", "decision_status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(claude|codex|copilot|cross-tool):[a-z-]+:(?:[A-Za-z0-9._-]|%[0-9A-F]{2})+(?:/(?:[A-Za-z0-9._-]|%[0-9A-F]{2})*)*(?:~(?:[A-Za-z0-9._-]|%[0-9A-F]{2})+(?:~[0-9]{2})?)?$"
        },
        "ecosystem": {
          "type": "string",
          "enum": ["claude", "codex", "copilot", "cross-tool"]
        },
        "kind": {
          "type": "string",
          "enum": ["instructions", "path-scoped-rule", "skill", "skill-frontmatter-field", "skill-metadata-file", "agent", "subagent-frontmatter-field", "handoff", "prompt", "hook-registration", "permission", "setting", "mcp-server"]
        },
        "name": { "type": "string", "minLength": 1 },
        "source_path": { "$ref": "#/$defs/repositoryPath" },
        "source_pointer": { "type": "string" },
        "disposition": {
          "type": "string",
          "enum": ["shared", "native", "generated", "dropped"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "target_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "generated_from": {
          "anyOf": [
            { "$ref": "#/$defs/repositoryPath", "not": { "pattern": "^pending-source:" } },
            { "type": "string", "pattern": "^pending-source:[a-z-]+$" }
          ]
        },
        "generator": { "type": "string" },
        "parity_group": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["claude-code", "codex", "copilot-vscode", "copilot-cli", "copilot-cloud"]
          }
        },
        "owner_child": {
          "type": ["integer", "null"],
          "minimum": 3,
          "maximum": 7
        },
        "decision_status": {
          "type": "string",
          "enum": ["approved", "provisional"]
        },
        "decision_ref": {
          "type": "string",
          "pattern": "^#\\d+:[^\\s]+$"
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "dropped" } }, "required": ["disposition"] },
          "then": { "required": ["reason", "decision_ref"], "not": { "required": ["target_paths"] } }
        },
        {
          "if": { "properties": { "disposition": { "enum": ["shared", "generated"] } }, "required": ["disposition"] },
          "then": { "required": ["target_paths"] }
        },
        {
          "if": { "properties": { "disposition": { "const": "generated" } }, "required": ["disposition"] },
          "then": { "required": ["generated_from"] }
        },
        {
          "if": { "properties": { "decision_status": { "const": "provisional" } }, "required": ["decision_status"] },
          "then": { "required": ["decision_ref"] }
        },
        {
          "if": { "properties": { "generated_from": { "pattern": "^pending-source:" } }, "required": ["generated_from"] },
          "then": { "properties": { "decision_status": { "const": "provisional" } }, "required": ["decision_status"] }
        }
      ]
    }
  }
}
