{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drm-copilot:discovery:2.0.0:host-observation",
  "title": "Discovery v2 host observation",
  "description": "One PreToolUse payload the native gate attributed to a capability sentinel agent, recorded as received. The capability probe proves host attribution from these records; the sentinel MCP tool consumes the one-use sentinel grant fields exactly once. Nothing in this record confers authority on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_kind",
    "id",
    "observation_ref",
    "host",
    "session_id",
    "agent_id",
    "agent_type",
    "parent_agent_id",
    "tool_name",
    "tool_use_id_present",
    "decision",
    "code",
    "handler_sha256",
    "observed_at"
  ],
  "properties": {
    "$schema": {"const":"urn:drm-copilot:discovery:2.0.0:host-observation"},
    "schema_version": {"const":"2.0.0"},
    "artifact_kind": {"const":"host-observation"},
    "id": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
    "observation_ref": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/opaque-reference"},
    "host": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/host"},
    "session_id": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},
    "agent_id": {"anyOf":[{"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},{"type":"null"}]},
    "agent_type": {"anyOf":[{"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},{"type":"null"}]},
    "parent_agent_id": {"$ref":"urn:drm-copilot:discovery:2.0.0:service-request#/$defs/correlation-id"},
    "tool_name": {"type":"string","minLength":1,"maxLength":256,"pattern":"\\S"},
    "tool_use_id_present": {"type":"boolean"},
    "decision": {"enum":["allow","deny"]},
    "code": {"type":"string","pattern":"^[A-Z][A-Z0-9_]*$(?![\\s\\S])"},
    "handler_sha256": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"},
    "observed_at": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/timestamp"},
    "tool": {"const":"discovery_capability_sentinel"},
    "input_sha256": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/sha256"},
    "expires_at": {"$ref":"urn:drm-copilot:discovery:2.0.0:common#/$defs/timestamp"},
    "state": {"enum":["issued","consumed","revoked"]}
  },
  "dependentRequired": {
    "tool": ["input_sha256","expires_at","state"],
    "input_sha256": ["tool","expires_at","state"],
    "expires_at": ["tool","input_sha256","state"],
    "state": ["tool","input_sha256","expires_at"]
  }
}
