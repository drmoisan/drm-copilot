{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(poetry run *)",
      "Bash(pwsh *)",
      "Bash(npx *)",
      "Read",
      "Edit(/docs/**)",
      "Write(/docs/**)",
      "Write(/artifacts/**)",
      "mcp__drmCopilotExtension__.*",
      "Skill(orchestrate *)",
      "Skill(commit-message *)",
      "Skill(pr-author *)",
      "Skill(research-issue *)"
    ],
    "deny": [
      ".env",
      "**/.env",
      "**/secrets/**",
      "**/*.key",
      "**/*.pem"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "atomic-planner|atomic-executor|feature-review|task-researcher",
        "command": "pwsh -NoProfile -Command \"$input = $env:CLAUDE_HOOK_INPUT | ConvertFrom-Json; $output = $input.output; if (-not ($output -match '(plan-path|research-path|review-artifact|PREFLIGHT|evidence/)')) { Write-Error 'Subagent stopped without required completion artifact path'; exit 1 }; exit 0\""
      }
    ],
    "PreToolUse": [
      {
        "event": "Bash",
        "command": "pwsh -NoProfile -File .claude/hooks/validate-bash.ps1"
      }
    ]
  },
  "defaultPermissionMode": "acceptEdits"
}
