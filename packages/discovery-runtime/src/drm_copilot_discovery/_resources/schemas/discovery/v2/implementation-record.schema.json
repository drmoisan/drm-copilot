{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drm-copilot:discovery:2.0.0:implementation-record",
  "title": "Discovery v2 target implementation record",
  "description": "Pinned target implementation and test references. This artifact cannot redefine observed source behavior.",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "artifact_kind", "id", "target_repository", "client_id", "feature_refs", "implementation_paths", "test_references", "verification_evidence_refs", "verification_state", "verification_reason", "extensions"],
  "properties": {
    "$schema": {"const": "urn:drm-copilot:discovery:2.0.0:implementation-record"},
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "implementation-record"},
    "id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
    "target_repository": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/repository-reference"},
    "client_id": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifier"},
    "feature_refs": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/feature-references", "minItems": 1},
    "implementation_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:drm-copilot:discovery:2.0.0:inventory-snapshot#/$defs/source"}},
    "test_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/test-reference"}},
    "verification_evidence_refs": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/evidence-references"},
    "verification_state": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/dimension-verification"},
    "verification_reason": {"anyOf": [{"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"}, {"type": "null"}]},
    "extensions": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/extensions"}
  },
  "allOf": [
    {
      "if": {"properties": {"verification_state": {"const": "passed"}}, "required": ["verification_state"]},
      "then": {"properties": {"test_references": {"contains": {"properties": {"verification_state": {"const": "passed"}}, "required": ["verification_state"]}}}}
    },
    {
      "if": {"properties": {"verification_state": {"const": "failed"}}, "required": ["verification_state"]},
      "then": {"properties": {"test_references": {"contains": {"properties": {"verification_state": {"const": "failed"}}, "required": ["verification_state"]}}}}
    },
    {
      "if": {"properties": {"verification_state": {"enum": ["passed", "failed"]}}, "required": ["verification_state"]},
      "then": {"properties": {"verification_evidence_refs": {"minItems": 1}, "test_references": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"verification_state": {"enum": ["blocked", "not-applicable"]}}, "required": ["verification_state"]},
      "then": {"properties": {"verification_reason": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/text"}}}
    }
  ],
  "$defs": {
    "test-reference": {
      "type": "object", "additionalProperties": false, "required": ["source", "modes", "platforms", "verification_state", "evidence_refs"],
      "properties": {
        "source": {"$ref": "urn:drm-copilot:discovery:2.0.0:inventory-snapshot#/$defs/source"},
        "modes": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifiers", "minItems": 1},
        "platforms": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/identifiers"},
        "verification_state": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/dimension-verification"},
        "evidence_refs": {"$ref": "urn:drm-copilot:discovery:2.0.0:common#/$defs/evidence-references"}
      },
      "if": {"properties": {"verification_state": {"enum": ["passed", "failed"]}}, "required": ["verification_state"]},
      "then": {"properties": {"evidence_refs": {"minItems": 1}}}
    }
  }
}
