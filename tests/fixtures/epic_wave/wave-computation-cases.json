{
  "version": 1,
  "cases": [
    { "name": "empty", "manifest": {}, "expected_waves": {} },
    { "name": "single", "manifest": { "a": [] }, "expected_waves": { "a": 0 } },
    {
      "name": "chain",
      "manifest": { "a": [], "b": ["a"], "c": ["b"], "d": ["c"] },
      "expected_waves": { "a": 0, "b": 1, "c": 2, "d": 3 }
    },
    {
      "name": "diamond",
      "manifest": { "child-a": [], "child-b": ["child-a"], "child-c": ["child-a"], "child-d": ["child-b", "child-c"] },
      "expected_waves": { "child-a": 0, "child-b": 1, "child-c": 1, "child-d": 2 }
    },
    {
      "name": "multiple-roots",
      "manifest": { "r1": [], "r2": [], "x": ["r1", "r2"], "y": ["r2"], "z": ["x", "y"] },
      "expected_waves": { "r1": 0, "r2": 0, "x": 1, "y": 1, "z": 2 }
    },
    {
      "name": "case-variant-keys",
      "manifest": { "a": [], "A": ["a"] },
      "expected_waves": { "a": 0, "A": 1 }
    },
    { "name": "two-node-cycle", "manifest": { "a": ["b"], "b": ["a"] }, "expected_error": "cycle" },
    { "name": "self-loop", "manifest": { "a": ["a"] }, "expected_error": "self_loop" },
    { "name": "unresolved-reference", "manifest": { "a": ["missing"] }, "expected_error": "unresolved" }
  ]
}
