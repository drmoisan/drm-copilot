{
  "name": "drm-copilot",
  "displayName": "drm-copilot",
  "description": "Extension-side bundled workflow execution utilities and MCP bridge.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "drmCopilotMcpProvider",
        "label": "drm-copilot Repo Automation"
      }
    ],
    "commands": [
      {
        "command": "drmCopilotExtension.helloPython",
        "title": "drm-copilot: Hello Python"
      },
      {
        "command": "drmCopilotExtension.helloPowerShell",
        "title": "drm-copilot: Hello PowerShell"
      },
      {
        "command": "drmCopilotExtension.collectCommitContext",
        "title": "drm-copilot: Collect Commit Context"
      },
      {
        "command": "drmCopilotExtension.collectPrContext",
        "title": "drm-copilot: Collect PR Context"
      },
      {
        "command": "drmCopilotExtension.newActiveFeatureFolder",
        "title": "drm-copilot: New Active Feature Folder"
      },
      {
        "command": "drmCopilotExtension.potentialToIssue",
        "title": "drm-copilot: Potential To Issue"
      },
      {
        "command": "drmCopilotExtension.newPotentialBugEntry",
        "title": "drm-copilot: New Potential Bug Entry"
      },
      {
        "command": "drmCopilotExtension.newPotentialEntry",
        "title": "drm-copilot: New Potential Entry"
      },
      {
        "command": "drmCopilotExtension.linkParentChild",
        "title": "drm-copilot: Link Parent/Child Issues"
      },
      {
        "command": "drmCopilotExtension.pushDownCopilotCustomizations",
        "title": "drm-copilot: Push Down Copilot Customizations"
      },
      {
        "command": "drmCopilotExtension.pushDownCodexAndAgentsCustomizations",
        "title": "drm-copilot: Push Down Codex and Agents Customizations"
      },
      {
        "command": "drmCopilotExtension.syncAgentsFromInstructions",
        "title": "drm-copilot: Sync AGENTS.md from Instructions"
      },
      {
        "command": "drmCopilotExtension.runPoshQCSuite",
        "title": "drm-copilot: Run PoshQC Suite"
      },
      {
        "command": "drmCopilotExtension.listMcpTools",
        "title": "drm-copilot: List MCP Tools"
      },
      {
        "command": "drmCopilotExtension.runPoshQCFormat",
        "title": "drm-copilot: Run PoshQC Format"
      },
      {
        "command": "drmCopilotExtension.runPoshQCAnalyze",
        "title": "drm-copilot: Run PoshQC Analyze"
      },
      {
        "command": "drmCopilotExtension.runPoshQCTest",
        "title": "drm-copilot: Run PoshQC Test"
      },
      {
        "command": "drmCopilotExtension.runPoshQCAnalyzeAutofix",
        "title": "drm-copilot: Run PoshQC Analyze Autofix"
      },
      {
        "command": "drmCopilotExtension.resolvePolicyAuditTemplateAsset",
        "title": "drm-copilot: Resolve Policy Audit Template Asset"
      },
      {
        "command": "drmCopilotExtension.resolveExecuteHardLockPrompt",
        "title": "drm-copilot: Resolve Execute Hard-Lock Prompt"
      },
      {
        "command": "drmCopilotExtension.resolveAtomicPlanPrompt",
        "title": "drm-copilot: Resolve Atomic Plan Prompt"
      },
      {
        "command": "drmCopilotExtension.newClaudeWorktreeSession",
        "title": "drm-copilot: New Claude Worktree Session"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run bundle:mcp-server",
    "build": "tsc -p ./ && npm run bundle:mcp-server",
    "bundle:mcp-server": "node esbuild-mcp-server.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.cjs\"",
    "lint": "eslint --no-error-on-unmatched-pattern src test",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "node run-jest.cjs",
    "test:unit": "node run-jest.cjs"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "jest": "^30.0.0",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
